# ----------------------------------------------------------------------
# 1. بيئة Python والمكتبات (لـ Anaconda, Jupyter, Venv)
# ----------------------------------------------------------------------
# المجلد الافتراضي للبيئة الافتراضية في Python
venv/
.venv/
# ملفات تخزين البايت كود (Bytecode)
__pycache__/
# ملفات تنفيذ Python
*.pyc

# ملفات Jupyter Notebooks المؤقتة والمخرجات
.ipynb_checkpoints
# ملفات مخرجات تحليل البيانات (إذا كانت ضخمة ولا تحتاج إلى تتبع)
/Analysis/output/

# ----------------------------------------------------------------------
# 2. ملفات Excel و Power BI و Tableau
# ----------------------------------------------------------------------
# ملفات Excel المؤقتة والتنفيذية
~$*.xlsx
*.xlk
*.xlsb

# ملفات لوحة القيادة لـ Power BI و Tableau (قد تكون كبيرة جداً)
# يمكنك تركها إذا كانت صغيرة، لكن يفضل استبعادها إذا كانت تتجاوز 100MB
# *يُفضل رفع لقطات الشاشة في Visualizations/Screenshots بدلاً من الملفات التنفيذية الكبيرة.
# *.pbix
# *.twbx

# ----------------------------------------------------------------------
# 3. ملفات قاعدة البيانات وكلمات المرور (أمان)
# ----------------------------------------------------------------------
# ملفات الإعدادات التي قد تحتوي على بيانات حساسة (مثل كلمة مرور قاعدة البيانات)
.env
config.ini
database.yml

# ملفات مخرجات SQL الكبيرة أو سجلات الأخطاء
*.log
*.bak
*.dump
# إذا كان لديك ملفات .sqlite
*.sqlite

# ----------------------------------------------------------------------
# 4. بيئة التشغيل ونظام التشغيل (MacOS/Windows)
# ----------------------------------------------------------------------
# ملفات نظام التشغيل macOS
.DS_Store
# ملفات نظام التشغيل Windows
Thumbs.db

# ----------------------------------------------------------------------
# 5. مجلدات التنفيذ المؤقتة
# ----------------------------------------------------------------------
# إذا كان لديك مجلد خاص بالمخرجات المؤقتة
/temp/
